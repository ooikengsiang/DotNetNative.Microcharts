<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android;net9.0-ios;net9.0-macos;net10.0;net10.0-android;net10.0-ios;net10.0-macos</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DotNetNative.Microcharts</PackageId>
    <AssemblyName>Microcharts</AssemblyName>
    <authors>Ooi Keng Siang, eman1986, Eilon</authors>
    <Version>1.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Microcharts Library for .NET 9 and .NET 10 native iOS / Android / Mac</Title>
    <Description>An extremely simple charting library for .NET 9 and .NET 10 native Android, iOS and Mac OS.</Description>
    <PackageTags>microcharts, xamarin, .net, .net9, .net10, native, android, ios, mac</PackageTags>
    <RepositoryUrl>https://github.com/ooikengsiang/DotNetNative.Microcharts.git</RepositoryUrl> 
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.4" />
  </ItemGroup>
</Project>
